{
  "name": "taro-app",
  "version": "1.0.0",
  "private": true,
  "description": "taro-app",
  "templateInfo": {
    "name": "default",
    "typescript": true,
    "css": "Sass",
    "framework": "React"
  },
  "scripts": {
    "build:weapp": "taro build --type weapp",
    "build:swan": "taro build --type swan",
    "build:alipay": "taro build --type alipay",
    "build:tt": "taro build --type tt",
    "build:h5": "taro build --type h5",
    "build:rn": "taro build --type rn",
    "build:qq": "taro build --type qq",
    "build:jd": "taro build --type jd",
    "build:quickapp": "taro build --type quickapp",
    "build:harmony-hybrid": "taro build --type harmony-hybrid",
    "dev:weapp": "npm run build:weapp -- --watch",
    "dev:swan": "npm run build:swan -- --watch",
    "dev:alipay": "npm run build:alipay -- --watch",
    "dev:tt": "npm run build:tt -- --watch",
    "dev:h5": "npm run build:h5 -- --watch",
    "dev:rn": "npm run build:rn -- --watch",
    "dev:qq": "npm run build:qq -- --watch",
    "dev:jd": "npm run build:jd -- --watch",
    "dev:quickapp": "npm run build:quickapp -- --watch",
    "dev:harmony-hybrid": "npm run build:harmony-hybrid -- --watch",
    "test": "jest",
    "build:weapp:test": "taro build --type weapp --mode test",
    "build:swan:test": "taro build --type swan --mode test",
    "build:alipay:test": "taro build --type alipay --mode test",
    "build:tt:test": "taro build --type tt --mode test",
    "build:h5:test": "taro build --type h5 --mode test",
    "build:rn:test": "taro build --type rn --mode test",
    "open": "weapp open -p",
    "postinstall": "weapp-tw patch"
  },
  "browserslist": {
    "development": [
      "defaults and fully supports es6-module",
      "maintained node versions"
    ],
    "production": [
      "last 3 versions",
      "Android >= 4.1",
      "ios >= 8"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "git add"
    ]
  },
  "author": "",
  "dependencies": {
    "@babel/runtime": "^7.27.1",
    "@nutui/nutui-react-taro": "^3.0.10",
    "@tarojs/components": "4.0.12",
    "@tarojs/helper": "4.0.12",
    "@tarojs/plugin-framework-react": "4.0.12",
    "@tarojs/plugin-html": "4.0.12",
    "@tarojs/plugin-http": "4.0.12",
    "@tarojs/plugin-platform-alipay": "4.0.12",
    "@tarojs/plugin-platform-h5": "4.0.12",
    "@tarojs/plugin-platform-harmony-hybrid": "4.0.12",
    "@tarojs/plugin-platform-jd": "4.0.12",
    "@tarojs/plugin-platform-qq": "4.0.12",
    "@tarojs/plugin-platform-swan": "4.0.12",
    "@tarojs/plugin-platform-tt": "4.0.12",
    "@tarojs/plugin-platform-weapp": "4.0.12",
    "@tarojs/react": "4.0.12",
    "@tarojs/runtime": "4.0.12",
    "@tarojs/shared": "4.0.12",
    "@tarojs/taro": "4.0.12",
    "ahooks": "^3.8.4",
    "axios": "^1.9.0",
    "dayjs": "^1.11.13",
    "lodash-es": "^4.17.21",
    "qs": "^6.14.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.4"
  },
  "devDependencies": {
    "@babel/core": "^7.27.1",
    "@babel/plugin-transform-class-properties": "^7.27.1",
    "@babel/preset-react": "^7.27.1",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.6.0",
    "@tailwindcss/postcss": "^4.1.5",
    "@tarojs/cli": "4.0.12",
    "@tarojs/taro-loader": "4.0.12",
    "@tarojs/test-utils-react": "^0.1.1",
    "@tarojs/webpack5-runner": "4.0.12",
    "@types/jest": "^29.5.14",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.15.3",
    "@types/qs": "^6.9.18",
    "@types/react": "^19.1.2",
    "@types/webpack-env": "^1.18.8",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
